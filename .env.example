# Server only: never bundle this file into Electron.
# Paste the Neon connection string, including its SSL parameters.
DATABASE_URL=
# Optional direct (non-pooler) URL for migrations; defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=
# npm run setup generates both app secrets once. Keep them stable after setup.
TOKEN_ENCRYPTION_KEY=
PORT=3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google callback: http://localhost:3001/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub callback: http://localhost:3001/api/auth/callback/github
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
# Register http://localhost:3001/onshape/callback for local development.
ONSHAPE_API_VERSION=v17
# Server-side Haskell executable. Required for CAD reads and edits; see kernel/.
ZITHER_KERNEL_PATH=

# Public server origin used by the Electron main process.
ZITHER_SERVER_URL=http://localhost:3001
