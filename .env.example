# Server only: never bundle this file into Electron.
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
PORT=3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
# Register http://localhost:3001/onshape/callback for local development.
ONSHAPE_API_VERSION=v17
# Server-side Haskell executable. Required for CAD reads and edits; see kernel/.
ZITHER_KERNEL_PATH=

# Public server origin used by the Electron main process.
ZITHER_SERVER_URL=http://localhost:3001
