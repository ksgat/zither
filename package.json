{
  "name": "zither",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Pi-powered desktop CAD assistant for Onshape",
  "main": "dist/electron/main.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "npm run typecheck && vite build && node scripts/build.mjs",
    "start": "electron .",
    "server": "tsx --env-file=.env server/index.ts",
    "db:migrate": "tsx --env-file=.env server/migrate.ts",
    "db:check": "tsx --env-file=.env server/migrate.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/smoke-electron.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "better-auth": "1.7.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "electron": "44.5.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
